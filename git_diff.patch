+		await recordEvent(env, {
+			type: 'playback_started',
+			userId: 'anonymous',
+			workspaceId: video.workspaceId,
+			videoId: video.id,
+			sessionId: sessionId || video.sessionId
+		});
+
+		return Response.json(video);
+	} catch (err: any) {
