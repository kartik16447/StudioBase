{
  "key": "",
  "manifest_version": 3,
  "name": "Foyr Screen Recorder",
  "version": "1.0.3",
  "description": "Record your screen and share instantly",
  "permissions": [
    "tabs",
    "storage",
    "identity",
    "offscreen",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://screenvault-proxy.tushar-abf.workers.dev/*",
    "https://screenvault-backend.tushar-abf.workers.dev/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "oauth2": {
    "client_id": "219621491181-6spsdkmasuh1nf534s4371shlgtlf8ek.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
