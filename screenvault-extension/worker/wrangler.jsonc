{
  "name": "screenvault-proxy",
  "main": "index.ts",
  "compatibility_date": "2024-04-15",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screenvault-db",
      "database_id": "a316da5a-2f9b-4a4a-9320-93333036328c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "screenvault-videos"
    }
  ]
}
